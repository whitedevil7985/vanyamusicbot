#!/bin/bash
cd "$(dirname "$0")"

if [ -f .venv/bin/python3 ]; then
    exec .venv/bin/python3 -m anony
elif command -v uv &>/dev/null; then
    exec uv run python3 -m anony
elif [ -f "$HOME/.local/bin/uv" ]; then
    exec "$HOME/.local/bin/uv" run python3 -m anony
else
    exec python3 -m anony
fi
